DB_HOST=localhost
DB_PORT=5432
DB_NAME=meeting_assistant
DB_USER=meeting
DB_PASSWORD=meeting

OLLAMA_HOST=http://127.0.0.1:11434
LLM_MODEL=qwen3.8:27b
LLM_BACKEND=ollama
LLM_NUM_CTX=131072
LLM_TEMPERATURE=0
LLM_SEED=42
LLM_THINK=True

ASR_ENGINE=hf
ASR_MODEL_ZH=
ASR_MODEL_NAN=
ASR_MODEL_HAK=
ASR_MODEL_EN=
ASR_TO_TRADITIONAL=true
ASR_HALLUCINATION_MAX_S=2.0
ASR_MERGE_GAP_S=1.0
ASR_MERGE_MAX_S=20
ASR_MERGE_SHORT_S=3.0
ASR_DROP_QUIET_DB=35

MAX_UPLOAD_MB=500

SESSION_TTL_SECONDS=28800

DEMO_USERNAME=demo
DEMO_PASSWORD=demo1234demo1234demo1234

TYPO_CHECK=true
TYPO_CHUNK=40
TYPO_THINK=false

ASSISTANT_THINK=false
ASSISTANT_MAX_STEPS=5
TIMEZONE=Asia/Taipei

# Google 登入（僅雲端模式需要；本機模式免登入）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_BASE=http://localhost:8000
APP_URL_SCHEME=meetsum

# Cloudflare Worker 固定入口（Colab 啟動時把臨時網址發佈到這裡）
DISCOVERY_URL=
